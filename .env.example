# ──────────────────────────────────────────────────────────────────────────
# DeenSteps environment variables
# Copy this file to `.env` and fill in the values before running.
# ──────────────────────────────────────────────────────────────────────────

# Database — SQLite file path (used for local dev and the default Docker setup)
# The file is created automatically inside the container at /app/db/deensteps.db
DATABASE_URL="file:/app/db/deensteps.db"

# NextAuth.js — generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string-please"

# NextAuth.js — the public URL of your deployment
# Use http://localhost:3000 for local development
NEXTAUTH_URL="http://localhost:3000"
