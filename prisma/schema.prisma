// DeenSteps — Premium Islamic Family Habit & Rewards SaaS
// Prisma schema (SQLite for dev; designed for PostgreSQL in production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Authentication
// ────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  families       FamilyMembership[]
  ownedFamilies  Family[]           @relation("FamilyOwner")
  reviews        TaskReview[]
  reviewedSubmissions TaskSubmission[] @relation("SubmissionReviewer")
  rewardApprovals RewardRedemption[] @relation("RewardApprover")
  auditLogs      AuditLog[]
  notifications  Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────────────────────────────────────────────────────────────────────
// Family & Children
// ────────────────────────────────────────────────────────────────────────────

model Family {
  id           String   @id @default(cuid())
  name         String
  timezone     String   @default("UTC")
  locale       String   @default("en")
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdByUser  User                @relation("FamilyOwner", fields: [createdBy], references: [id])
  memberships    FamilyMembership[]
  children       ChildProfile[]
  tasks          TaskTemplate[]
  rewards        Reward[]
  challenges     WeeklyChallenge[]
  achievements   Achievement[]
  settings       FamilySettings?
  auditLogs      AuditLog[]

  @@index([createdBy])
}

model FamilyMembership {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  role      String   @default("PARENT") // PARENT | CAREGIVER
  createdAt DateTime @default(now())

  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

model ChildProfile {
  id          String    @id @default(cuid())
  familyId    String
  displayName String
  avatar      String?
  avatarColor String    @default("emerald")
  birthDate   DateTime?
  ageRange    String?   // "3-5" | "6-8" | "9-12" | "13+"
  preferredLanguage String @default("en")
  pinHash     String?   // optional 4-digit PIN for child access
  status      String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  family        Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignments   TaskAssignment[]
  submissions   TaskSubmission[]
  pointsTxns    PointsTransaction[]
  redemptions   RewardRedemption[]
  challengeParts ChallengeParticipant[]
  childAchievements ChildAchievement[]
  notifications  Notification[]

  @@index([familyId])
  @@index([status])
}

model FamilySettings {
  id                    String   @id @default(cuid())
  familyId              String   @unique
  defaultApprovalPolicy String   @default("MANUAL") // MANUAL | AUTO
  pointsName            String   @default("Points")
  weeklyStartDay        String   @default("SUNDAY") // SUNDAY..SATURDAY
  monthlyPlanType       String   @default("FOUR_WEEK") // FOUR_WEEK | CALENDAR_MONTH
  monthlyQualifyingWeeks Int     @default(3)
  notifyOnSubmission    Boolean  @default(true)
  notifyOnRedemption    Boolean  @default(true)
  notifyOnChallengeEnd  Boolean  @default(true)
  notifyOnMilestone     Boolean  @default(true)
  emailNotifications    Boolean  @default(false)
  theme                 String   @default("light")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────────
// Tasks
// ────────────────────────────────────────────────────────────────────────────

model TaskTemplate {
  id              String   @id @default(cuid())
  familyId        String
  title           String
  description     String?
  instructions    String?
  category        String   @default("Personal Responsibility")
  subcategory     String?
  iconKey         String   @default("check")
  pointsValue     Int      @default(1)
  approvalPolicy  String   @default("MANUAL") // MANUAL | AUTO
  frequency       String   @default("DAILY") // ONCE | DAILY | WEEKLY | WEEKDAYS | CUSTOM
  scheduledDays   String?  // JSON: ["MON","WED","FRI"]
  startDate       DateTime?
  endDate         DateTime?
  dueTime         String?  // "07:30"
  parentNotes     String?
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  isFromLibrary   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignments     TaskAssignment[]
  occurrences     TaskOccurrence[]

  @@index([familyId])
  @@index([status])
  @@index([category])
}

model TaskAssignment {
  id           String   @id @default(cuid())
  taskId       String
  childId      String
  createdAt    DateTime @default(now())

  task         TaskTemplate @relation(fields: [taskId], references: [id], onDelete: Cascade)
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([taskId, childId])
  @@index([childId])
}

model TaskOccurrence {
  id           String   @id @default(cuid())
  taskId       String
  scheduledDate DateTime
  dueTime      String?
  status       String   @default("ASSIGNED") // ASSIGNED | SUBMITTED | NEEDS_ATTENTION | APPROVED | MISSED | EXCUSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task         TaskTemplate    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission   TaskSubmission?

  @@unique([taskId, scheduledDate])
  @@index([scheduledDate])
  @@index([status])
}

model TaskSubmission {
  id            String    @id @default(cuid())
  occurrenceId  String    @unique
  childId       String
  note          String?
  photoUrl      String?
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  decision      String?   // APPROVED | NEEDS_REVISION | REJECTED
  reviewerNote  String?
  pointsAwarded Int       @default(0)
  pointsTxnId   String?   @unique

  occurrence    TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  child         ChildProfile   @relation(fields: [childId], references: [id], onDelete: Cascade)
  reviewedBy    User?          @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  pointsTxn     PointsTransaction? @relation(fields: [pointsTxnId], references: [id])
  reviews       TaskReview[]

  @@index([childId])
  @@index([decision])
}

model TaskReview {
  id          String   @id @default(cuid())
  submissionId String
  reviewerId  String
  decision    String   // APPROVED | NEEDS_REVISION | REJECTED
  note        String?
  pointsAwarded Int    @default(0)
  createdAt   DateTime @default(now())

  submission  TaskSubmission @relation(fields: [submissionId], references: [id])
  reviewer    User           @relation(fields: [reviewerId], references: [id])

  @@index([submissionId])
}

model TaskExcusal {
  id           String   @id @default(cuid())
  occurrenceId String   @unique
  reason       String
  createdAt    DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// Points Ledger
// ────────────────────────────────────────────────────────────────────────────

model PointsTransaction {
  id          String   @id @default(cuid())
  childId     String
  familyId    String
  amount      Int      // positive = credit, negative = debit
  type        String   // EARNED | REDEMPTION | ADJUSTMENT | REFUND
  reference   String?  // submissionId | redemptionId
  description String
  balanceAfter Int
  createdAt   DateTime @default(now())

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  submission  TaskSubmission?
  redemption  RewardRedemption?

  @@index([childId])
  @@index([familyId])
  @@index([type])
}

// ────────────────────────────────────────────────────────────────────────────
// Rewards
// ────────────────────────────────────────────────────────────────────────────

model Reward {
  id             String   @id @default(cuid())
  familyId       String
  title          String
  description    String?
  iconKey        String   @default("gift")
  requiredPoints Int
  rewardType     String   @default("POINTS") // POINTS | ACHIEVEMENT
  eligibilityMode String  @default("ALL") // ALL | SELECTED
  redemptionLimit Int?    // max redemptions per child, null = unlimited
  expirationDate DateTime?
  requiresApproval Boolean @default(true)
  status         String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  family        Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  redemptions   RewardRedemption[]
  eligibilities RewardEligibility[]

  @@index([familyId])
  @@index([status])
}

model RewardEligibility {
  id        String @id @default(cuid())
  rewardId  String
  childId   String

  reward    Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, childId])
}

model RewardRedemption {
  id           String    @id @default(cuid())
  rewardId     String
  childId      String
  status       String    @default("REQUESTED") // REQUESTED | APPROVED | DECLINED | FULFILLED | CANCELLED
  pointsCost   Int
  pointsTxnId  String?   @unique
  requestedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  fulfilledAt  DateTime?
  note         String?

  reward       Reward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  child        ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("RewardApprover", fields: [reviewedById], references: [id])
  pointsTxn    PointsTransaction? @relation(fields: [pointsTxnId], references: [id])

  @@index([childId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Weekly Challenges & Monthly Milestones
// ────────────────────────────────────────────────────────────────────────────

model WeeklyChallenge {
  id              String   @id @default(cuid())
  familyId        String
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  targetPercent   Int      @default(80)
  eligibleCategories String? // JSON list
  rewardId        String?
  rewardTitle     String?
  status          String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family        Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  participants  ChallengeParticipant[]

  @@index([familyId])
  @@index([status])
}

model ChallengeParticipant {
  id           String   @id @default(cuid())
  challengeId  String
  childId      String
  targetPercent Int     @default(80)
  qualified    Boolean  @default(false)
  qualifiedAt  DateTime?
  completionPercent Int @default(0)
  eligibleCount Int     @default(0)
  completedCount Int    @default(0)

  challenge    WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  child        ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([challengeId, childId])
  @@index([childId])
}

model MonthlyMilestone {
  id           String   @id @default(cuid())
  familyId     String
  childId      String
  periodStart  DateTime
  periodEnd    DateTime
  qualifyingWeeks Int    @default(0)
  requiredWeeks  Int     @default(3)
  qualified    Boolean  @default(false)
  qualifiedAt  DateTime?
  rewardId     String?
  rewardTitle  String?

  @@unique([familyId, childId, periodStart])
  @@index([childId])
}

// ────────────────────────────────────────────────────────────────────────────
// Achievements
// ────────────────────────────────────────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  familyId    String
  key         String   // "first_steps" | "consistency_champion" etc.
  name        String
  description String
  iconKey     String   @default("award")
  criteria    String?  // JSON criteria
  createdAt   DateTime @default(now())

  family      Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childAchievements ChildAchievement[]

  @@unique([familyId, key])
}

model ChildAchievement {
  id            String   @id @default(cuid())
  achievementId String
  childId       String
  awardedAt     DateTime @default(now())

  achievement   Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([achievementId, childId])
}

// ────────────────────────────────────────────────────────────────────────────
// Notifications & Audit
// ────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  familyId  String?
  userId    String?
  childId   String?
  type      String   // TASK_SUBMITTED | TASK_APPROVED | REWARD_REQUESTED | CHALLENGE_ENDED | MILESTONE_REACHED | etc.
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  child     ChildProfile?  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([childId, read])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  familyId  String?
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String?  // JSON
  createdAt DateTime @default(now())

  family    Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([familyId])
  @@index([createdAt])
}
