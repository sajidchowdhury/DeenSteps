// DeenSteps — Premium Islamic Family Habit & Rewards SaaS
// Prisma schema (SQLite for dev; designed for PostgreSQL in production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Authentication
// ────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  families       FamilyMembership[]
  ownedFamilies  Family[]           @relation("FamilyOwner")
  reviews        TaskReview[]
  reviewedSubmissions TaskSubmission[] @relation("SubmissionReviewer")
  rewardApprovals RewardRedemption[] @relation("RewardApprover")
  auditLogs      AuditLog[]
  notifications  Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────────────────────────────────────────────────────────────────────
// Family & Children
// ────────────────────────────────────────────────────────────────────────────

model Family {
  id           String   @id @default(cuid())
  name         String
  timezone     String   @default("UTC")
  locale       String   @default("en")
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdByUser  User                @relation("FamilyOwner", fields: [createdBy], references: [id])
  memberships    FamilyMembership[]
  children       ChildProfile[]
  tasks          TaskTemplate[]
  rewards        Reward[]
  challenges     WeeklyChallenge[]
  achievements   Achievement[]
  settings       FamilySettings?
  auditLogs      AuditLog[]
  incidents      Incident[]
  sadaqahCauses  SadaqahCause[]
  sadaqahDonations SadaqahDonation[]
  reflections       WeeklyReflection[]
  familyAchievements FamilyAchievement[]

  @@index([createdBy])
}

model FamilyMembership {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  role      String   @default("PARENT") // PARENT | CAREGIVER
  createdAt DateTime @default(now())

  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

model ChildProfile {
  id          String    @id @default(cuid())
  familyId    String
  displayName String
  avatar      String?
  avatarColor String    @default("emerald")
  birthDate   DateTime?
  ageRange    String?   // "3-5" | "6-8" | "9-12" | "13+"
  preferredLanguage String @default("en")
  pinHash     String?   // optional 4-digit PIN for child access
  status      String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  family        Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignments   TaskAssignment[]
  submissions   TaskSubmission[]
  pointsTxns    PointsTransaction[]
  redemptions   RewardRedemption[]
  challengeParts ChallengeParticipant[]
  childAchievements ChildAchievement[]
  notifications  Notification[]
  incidentReports IncidentReport[]
  sadaqahDonations SadaqahDonation[]
  reflections     WeeklyReflection[]

  @@index([familyId])
  @@index([status])
}

model FamilySettings {
  id                    String   @id @default(cuid())
  familyId              String   @unique
  defaultApprovalPolicy String   @default("MANUAL") // MANUAL | AUTO
  pointsName            String   @default("Points")
  weeklyStartDay        String   @default("SUNDAY") // SUNDAY..SATURDAY
  monthlyPlanType       String   @default("FOUR_WEEK") // FOUR_WEEK | CALENDAR_MONTH
  monthlyQualifyingWeeks Int     @default(3)
  notifyOnSubmission    Boolean  @default(true)
  notifyOnRedemption    Boolean  @default(true)
  notifyOnChallengeEnd  Boolean  @default(true)
  notifyOnMilestone     Boolean  @default(true)
  emailNotifications    Boolean  @default(false)
  theme                 String   @default("light")
  // Phase 2 (S2.1): Monthly reward budget
  monthlyRewardBudget   Float?   // optional monthly spending limit (null = no budget)
  // Phase 4 (S4.1): Sadaqah pledge configuration
  sadaqahPledgeEnabled  Boolean  @default(false)
  sadaqahStarsPerUnit   Int      @default(100)
  sadaqahCurrency       String   @default("BDT")
  sadaqahAmountPerUnit  Float    @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────────
// Tasks
// ────────────────────────────────────────────────────────────────────────────

model TaskTemplate {
  id              String   @id @default(cuid())
  familyId        String
  title           String
  description     String?
  instructions    String?
  category        String   @default("Personal Responsibility")
  subcategory     String?
  iconKey         String   @default("check")
  pointsValue     Int      @default(1)
  approvalPolicy  String   @default("MANUAL") // MANUAL | AUTO
  frequency       String   @default("DAILY") // ONCE | DAILY | WEEKLY | WEEKDAYS | CUSTOM
  scheduledDays   String?  // JSON: ["MON","WED","FRI"]
  startDate       DateTime?
  endDate         DateTime?
  dueTime         String?  // "07:30"
  parentNotes     String?
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  isFromLibrary   Boolean  @default(false)
  // Phase 1 (S1.1): Tier & age-appropriate configuration
  tier            Int      @default(3)    // 1-5 priority (1 = core worship, 5 = optional growth)
  minAge          Int?                    // 3, 6, 9, 13 (null = all ages)
  maxAge          Int?                    // 5, 8, 12, 99
  learningPrompt  String?                // optional short Islamic learning question (Phase 5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignments     TaskAssignment[]
  occurrences     TaskOccurrence[]

  @@index([familyId])
  @@index([status])
  @@index([category])
  @@index([tier])
  @@index([category, tier])
}

model TaskAssignment {
  id           String   @id @default(cuid())
  taskId       String
  childId      String
  createdAt    DateTime @default(now())

  task         TaskTemplate @relation(fields: [taskId], references: [id], onDelete: Cascade)
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([taskId, childId])
  @@index([childId])
}

model TaskOccurrence {
  id           String   @id @default(cuid())
  taskId       String
  scheduledDate DateTime
  dueTime      String?
  status       String   @default("ASSIGNED") // ASSIGNED | SUBMITTED | NEEDS_ATTENTION | APPROVED | MISSED | EXCUSED
  // Phase 1 (S1.3): missed task audit trail
  missedAt     DateTime?  // when the system marked it missed (null = not missed)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task         TaskTemplate    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission   TaskSubmission?

  @@unique([taskId, scheduledDate])
  @@index([scheduledDate])
  @@index([status])
}

model TaskSubmission {
  id            String    @id @default(cuid())
  occurrenceId  String    @unique
  childId       String
  note          String?
  photoUrl      String?
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  decision      String?   // APPROVED | NEEDS_REVISION | REJECTED
  reviewerNote  String?
  pointsAwarded Int       @default(0)
  pointsTxnId   String?   @unique

  occurrence    TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  child         ChildProfile   @relation(fields: [childId], references: [id], onDelete: Cascade)
  reviewedBy    User?          @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  pointsTxn     PointsTransaction? @relation(fields: [pointsTxnId], references: [id])
  reviews       TaskReview[]

  @@index([childId])
  @@index([decision])
}

model TaskReview {
  id          String   @id @default(cuid())
  submissionId String
  reviewerId  String
  decision    String   // APPROVED | NEEDS_REVISION | REJECTED
  note        String?
  pointsAwarded Int    @default(0)
  createdAt   DateTime @default(now())

  submission  TaskSubmission @relation(fields: [submissionId], references: [id])
  reviewer    User           @relation(fields: [reviewerId], references: [id])

  @@index([submissionId])
}

model TaskExcusal {
  id             String   @id @default(cuid())
  occurrenceId   String   @unique
  reason         String
  // Phase 1 (S1.3): parent follow-up records
  excusedById    String?  // who excused the task
  followUpType   String?  // practice_wudu | learn_about_salah | plan_routine | other
  followUpNote   String?  // parent's follow-up note
  createdAt      DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// Points Ledger
// ────────────────────────────────────────────────────────────────────────────

model PointsTransaction {
  id          String   @id @default(cuid())
  childId     String
  familyId    String
  amount      Int      // positive = credit, negative = debit
  type        String   // EARNED | REDEMPTION | ADJUSTMENT | REFUND
  reference   String?  // submissionId | redemptionId
  description String
  balanceAfter Int
  // Phase 1 (S1.4): reason & actor for adjustments (used by Phase 3 incidents, Phase 4 sadaqah)
  reason      String?  // for ADJUSTMENT type: parent's reason
  adjustedById String? // who made the adjustment
  createdAt   DateTime @default(now())

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  submission  TaskSubmission?
  redemption  RewardRedemption?
  incidentResolution  IncidentResolution?
  sadaqahDonation  SadaqahDonation?

  @@index([childId])
  @@index([familyId])
  @@index([type])
}

// ────────────────────────────────────────────────────────────────────────────
// Rewards
// ────────────────────────────────────────────────────────────────────────────

model Reward {
  id             String   @id @default(cuid())
  familyId       String
  title          String
  description    String?
  iconKey        String   @default("gift")
  requiredPoints Int
  rewardType     String   @default("POINTS") // POINTS | ACHIEVEMENT
  eligibilityMode String  @default("ALL") // ALL | SELECTED
  redemptionLimit Int?    // max redemptions per child, null = unlimited
  expirationDate DateTime?
  requiresApproval Boolean @default(true)
  status         String   @default("ACTIVE") // ACTIVE | ARCHIVED
  // Phase 2 (S2.1): Category, frequency limits, estimated cost
  category       String   @default("EXPERIENCE") // EXPERIENCE | LEARNING | PRIVILEGE | FOOD
  maxPerWeek     Int?     // null = unlimited
  maxPerMonth    Int?     // null = unlimited
  cooldownDays   Int      @default(0) // min days between redemptions (0 = no cooldown)
  estimatedCost  Float?   // optional real-money cost for budget tracking
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  family        Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  redemptions   RewardRedemption[]
  eligibilities RewardEligibility[]

  @@index([familyId])
  @@index([status])
  @@index([familyId, category])
}

model RewardEligibility {
  id        String @id @default(cuid())
  rewardId  String
  childId   String

  reward    Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, childId])
}

model RewardRedemption {
  id           String    @id @default(cuid())
  rewardId     String
  childId      String
  status       String    @default("REQUESTED") // REQUESTED | APPROVED | DECLINED | FULFILLED | CANCELLED
  pointsCost   Int
  pointsTxnId  String?   @unique
  requestedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  fulfilledAt  DateTime?
  note         String?

  reward       Reward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  child        ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("RewardApprover", fields: [reviewedById], references: [id])
  pointsTxn    PointsTransaction? @relation(fields: [pointsTxnId], references: [id])

  @@index([childId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Weekly Challenges & Monthly Milestones
// ────────────────────────────────────────────────────────────────────────────

model WeeklyChallenge {
  id              String   @id @default(cuid())
  familyId        String
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  targetPercent   Int      @default(80)
  eligibleCategories String? // JSON list
  rewardId        String?
  rewardTitle     String?
  status          String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family        Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  participants  ChallengeParticipant[]

  @@index([familyId])
  @@index([status])
}

model ChallengeParticipant {
  id           String   @id @default(cuid())
  challengeId  String
  childId      String
  targetPercent Int     @default(80)
  qualified    Boolean  @default(false)
  qualifiedAt  DateTime?
  completionPercent Int @default(0)
  eligibleCount Int     @default(0)
  completedCount Int    @default(0)

  challenge    WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  child        ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([challengeId, childId])
  @@index([childId])
}

model MonthlyMilestone {
  id           String   @id @default(cuid())
  familyId     String
  childId      String
  periodStart  DateTime
  periodEnd    DateTime
  qualifyingWeeks Int    @default(0)
  requiredWeeks  Int     @default(3)
  qualified    Boolean  @default(false)
  qualifiedAt  DateTime?
  rewardId     String?
  rewardTitle  String?

  @@unique([familyId, childId, periodStart])
  @@index([childId])
}

// ────────────────────────────────────────────────────────────────────────────
// Achievements
// ────────────────────────────────────────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  familyId    String
  key         String   // "first_steps" | "consistency_champion" etc.
  name        String
  description String
  iconKey     String   @default("award")
  criteria    String?  // JSON criteria
  createdAt   DateTime @default(now())

  family      Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childAchievements ChildAchievement[]

  @@unique([familyId, key])
}

model ChildAchievement {
  id            String   @id @default(cuid())
  achievementId String
  childId       String
  awardedAt     DateTime @default(now())

  achievement   Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([achievementId, childId])
}

// ────────────────────────────────────────────────────────────────────────────
// Notifications & Audit
// ────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  familyId  String?
  userId    String?
  childId   String?
  type      String   // TASK_SUBMITTED | TASK_APPROVED | REWARD_REQUESTED | CHALLENGE_ENDED | MILESTONE_REACHED | etc.
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  child     ChildProfile?  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([childId, read])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  familyId  String?
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String?  // JSON
  createdAt DateTime @default(now())

  family    Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([familyId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 3 (S3.1): Incidents & Conflict Resolution
// ────────────────────────────────────────────────────────────────────────────

model Incident {
  id          String    @id @default(cuid())
  familyId    String
  status      String    @default("OPEN")  // OPEN | IN_MEDIATION | RESOLVED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  reports     IncidentReport[]
  resolution  IncidentResolution?

  @@index([familyId])
  @@index([status])
}

model IncidentReport {
  id           String   @id @default(cuid())
  incidentId   String
  childId      String
  whatHappened String
  whoInvolved  String?  // free text — sibling name, etc.
  howFelt      String?
  helpNeeded   String?
  createdAt    DateTime @default(now())

  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([childId])
}

model IncidentResolution {
  id             String   @id @default(cuid())
  incidentId     String   @unique
  outcomeType    String   // NO_ACTION | APOLOGY | RETURN_ITEM | REPAIR | HELPFUL_ACTION | CONSEQUENCE
  description    String
  pointsAdjusted Int      @default(0)  // 0 = no point change; negative = deduction; positive = restoration
  pointsTxnId    String?  @unique      // link to PointsTransaction if pointsAdjusted != 0
  reason         String?               // parent's reason (required if pointsAdjusted != 0)
  resolvedById   String
  createdAt      DateTime @default(now())

  incident       Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  pointsTxn      PointsTransaction? @relation(fields: [pointsTxnId], references: [id])

  @@index([incidentId])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 4 (S4.1): Sadaqah & Charitable Giving
// ────────────────────────────────────────────────────────────────────────────

model SadaqahCause {
  id          String   @id @default(cuid())
  familyId    String
  title       String
  description String?
  iconKey     String   @default("heart")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  donations   SadaqahDonation[]

  @@index([familyId, active])
}

model SadaqahDonation {
  id               String    @id @default(cuid())
  familyId         String
  childId          String
  causeId          String
  starsDedicated   Int     // points the child dedicated
  pointsTxnId      String?  @unique  // link to debit PointsTransaction
  status           String    @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  parentConfirmedAt DateTime?
  realAmount       Float?    // actual money donated (parent records)
  realDate         DateTime?
  confirmationNote String?
  createdAt        DateTime  @default(now())

  family           Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child            ChildProfile   @relation(fields: [childId], references: [id], onDelete: Cascade)
  cause            SadaqahCause   @relation(fields: [causeId], references: [id], onDelete: Cascade)
  pointsTxn        PointsTransaction? @relation(fields: [pointsTxnId], references: [id])

  @@index([familyId])
  @@index([childId])
  @@index([causeId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 5 (S5.1): Weekly Reflections & Family Achievements
// ────────────────────────────────────────────────────────────────────────────

model WeeklyReflection {
  id              String   @id @default(cuid())
  familyId        String
  childId         String?
  weekStart       DateTime
  weekEnd         DateTime
  whatWentWell    String?
  whatWasHard     String?
  whatEasier      String?
  nextWeekPlan    String?
  createdAt       DateTime @default(now())

  family          Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child           ChildProfile?  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([familyId, childId, weekStart])
  @@index([familyId, weekStart])
}

model FamilyAchievement {
  id          String   @id @default(cuid())
  familyId    String
  key         String   // "week_of_practice" | "family_service" | etc.
  name        String
  description String
  iconKey     String   @default("award")
  awardedAt   DateTime @default(now())

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, key])
  @@index([familyId])
}
